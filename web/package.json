{
  "name": "wifiprov-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The configurator side of the wifiprov protocol, for the browser.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --test \"test/e2e/*.e2e.ts\"",
    "build": "esbuild src/main.ts --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=../src/wifiprov/web/app.js"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
